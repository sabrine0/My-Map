{
  "version": 8,
  "name": "Earth",
  "projection": {
    "type": "globe"
  },
  "metadata": {
    "playground": {
      "globe": true,
      "pitch": 55,
      "bearing": -20
    }
  },
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "sat": {
      "type": "raster",
      "tileSize": 256,
      "maxzoom": 19,
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "attribution": "Imagery © Esri, Maxar, Earthstar Geographics"
    },
    "dem": {
      "type": "raster-dem",
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 15,
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "attribution": "Terrain: Mapzen / AWS Open Data"
    }
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "terrain": {
    "source": "dem",
    "exaggeration": 1.2
  },
  "sky": {
    "sky-color": "#06101f",
    "horizon-color": "#1e3a5f",
    "fog-color": "#0b1b33",
    "sky-horizon-blend": 0.5,
    "horizon-fog-blend": 0.5,
    "fog-ground-blend": 0.5,
    "atmosphere-blend": 0.9
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0b1b33"
      }
    },
    {
      "id": "satellite",
      "type": "raster",
      "source": "sat",
      "paint": {
        "raster-saturation": 0.05,
        "raster-contrast": 0.05
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "dem",
      "maxzoom": 12,
      "paint": {
        "hillshade-exaggeration": 0.2,
        "hillshade-shadow-color": "#000000",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-accent-color": "#000000"
      }
    },
    {
      "id": "building",
      "type": "fill-extrusion",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#e8e2d6",
        "fill-extrusion-height": [
          "coalesce",
          [
            "get",
            "render_height"
          ],
          8
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.8,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.55,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.6,
          17,
          2.5
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffe29a",
        "line-opacity": 0.8,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.6,
          12,
          1.4,
          16,
          4
        ]
      }
    },
    {
      "id": "road-highway",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffcc55",
        "line-opacity": 0.9,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.6,
          10,
          1.6,
          16,
          5
        ]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          "admin_level",
          2
        ],
        [
          "!=",
          "disputed",
          1
        ],
        [
          "!=",
          "maritime",
          1
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.7,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          0.6,
          10,
          1.8
        ],
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": [
        "!=",
        "class",
        "rail"
      ],
      "layout": {
        "text-font": [
          "Roboto Regular",
          "Noto Sans Regular"
        ],
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "<=",
          "rank",
          14
        ]
      ],
      "layout": {
        "text-font": [
          "Roboto Regular",
          "Noto Sans Regular"
        ],
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 10,
        "text-max-width": 8,
        "text-anchor": "top",
        "text-offset": [
          0,
          0.4
        ],
        "text-optional": true
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [
        "in",
        "class",
        "village",
        "hamlet",
        "suburb",
        "neighbourhood",
        "quarter"
      ],
      "layout": {
        "text-font": [
          "Roboto Regular",
          "Noto Sans Regular"
        ],
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          9,
          14,
          12
        ]
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "minzoom": 6,
      "filter": [
        "==",
        "class",
        "town"
      ],
      "layout": {
        "text-font": [
          "Roboto Regular",
          "Noto Sans Regular"
        ],
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          9,
          14,
          14
        ]
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "filter": [
        "==",
        "class",
        "city"
      ],
      "layout": {
        "text-font": [
          "Roboto Bold",
          "Noto Sans Bold"
        ],
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          10,
          12,
          20
        ]
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "maxzoom": 7,
      "filter": [
        "==",
        "class",
        "country"
      ],
      "layout": {
        "text-font": [
          "Roboto Bold",
          "Noto Sans Bold"
        ],
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          1,
          10,
          6,
          18
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    }
  ]
}